{
  "schema_version": 1,
  "authorized": true,
  "environment": "sandbox",
  "scope": {
    "synthetic": true,
    "backend": "local-state-only"
  },
  "selectors": [
    "Delete Account",
    "Restore Purchases",
    "Report Content"
  ],
  "transitions": {
    "Delete Account": {
      "flow": "account-deletion",
      "start": "Precheck Expo Clean",
      "success": "Account deleted",
      "failure": "Unexpected fixture error"
    },
    "Restore Purchases": {
      "flow": "restore",
      "start": "Precheck Expo Clean",
      "success": "Restore request completed",
      "failure": "Unexpected fixture error"
    },
    "Report Content": {
      "flow": "ugc-report",
      "start": "Precheck Expo Clean",
      "success": "Report submitted",
      "failure": "Unexpected fixture error"
    }
  }
}
